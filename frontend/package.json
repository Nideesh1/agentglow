{
  "name": "agentglow",
  "version": "0.1.0",
  "description": "Live 3D views of agent systems (LangGraph, deepagents, any OpenTelemetry-instrumented agents) as a React component.",
  "keywords": [
    "claude-code",
    "opentelemetry",
    "agents",
    "3d",
    "three.js",
    "langgraph",
    "deepagents",
    "react",
    "observability",
    "react-three-fiber",
    "nodejs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nideesh1/agentglow.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/Nideesh1/agentglow#readme",
  "bugs": {
    "url": "https://github.com/Nideesh1/agentglow/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pulse": {
      "types": "./dist/types/pulse.d.ts",
      "import": "./dist/pulse.js",
      "default": "./dist/pulse.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "node": "./dist/node.js",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentglow": "cli/agentglow.mjs"
  },
  "files": [
    "dist",
    "cli",
    "!cli/test"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib && npm run build:app",
    "build:app": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/postbuild-lib.mjs",
    "preview": "vite preview",
    "test": "node --test cli/test/*.test.mjs",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0 <1",
    "@opentelemetry/instrumentation": ">=0.200.0 <1",
    "@opentelemetry/instrumentation-http": ">=0.200.0 <1",
    "@opentelemetry/instrumentation-undici": ">=0.10.0 <1",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "@opentelemetry/instrumentation-http": {
      "optional": true
    },
    "@opentelemetry/instrumentation-undici": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
